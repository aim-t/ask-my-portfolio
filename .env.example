# Copy this file to .env and fill in at least ONE provider key.
# The app tries them in this order: OpenAI, then Anthropic, then Gemini.
# You do not need all three - one is enough to get answers.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides - sensible defaults are already set in app/config.py
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of origins allowed to call this API from a browser.
# Add your real portfolio domain here before deploying.
ALLOWED_ORIGINS=http://localhost:3000,https://aimantariq.tech,https://www.aimantariq.tech
